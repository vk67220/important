stages:
    - maven-build
    - maven-test
    - package-deploy
 
maven-compile:
    when: manual
    stage: maven-build
    tags:
       - tool
       - ec2
       - test
    script:
       - mvn clean install 
maven-test:
    when: manual
    stage: maven-test
    tags:
       - tool
    script:
        - mvn test
    artifacts:
        reports:
            junit:
                - target/surefire-reports/*.xml
        paths:
            - target/surefire-reports/
        untracked: false
        when: on_success
        access: all
        expire_in: 30 days
maven-package:
    when: manual
    stage: package-deploy
    tags:
       - tool
    script:
        - mvn deploy -s settings.xml


