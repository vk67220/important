        elif [[ "${SERVICE}" == "checkout" ]]; then

            echo "RUNTIME=node" >> $GITHUB_ENV

        elif [[ "${SERVICE}" == "catalog" ]]; then

            echo "RUNTIME=go" >> $GITHUB_ENV

        else

            echo "Unknown Service"
