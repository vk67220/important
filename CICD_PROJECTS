      desired_size   = 2
      max_size       = 2
    }
  }

  access_entries = {
    admin = {
      principal_arn = "arn:aws:iam::302524629943:user/app"

      policy_associations = {
        admin = {
          policy_arn = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
          access_scope = {
            type = "cluster"
          }
        }
      }
    }
  

  # GitHub OIDC Role (FIXES kubectl error)
