PHASE 3 — ACCESSING USING INGRESS (REAL PRODUCTION WAY)

Most companies use:

Internet
↓
DNS
↓
Ingress NGINX
↓
Grafana

Create DNS:

grafana.metatechz.store
prometheus.metatechz.store

Point both to:

Ingress ELB
grafana-ingress.yml

Create:

monitoring/grafana-ingress.yml
apiVersion: networking.k8s.io/v1
kind: Ingress

metadata:
  name: grafana-ingress
  namespace: monitoring

  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod

spec:
  ingressClassName: nginx

  tls:
    - hosts:
        - grafana.metatechz.store
      secretName: grafana-tls

  rules:
    - host: grafana.metatechz.store

      http:
        paths:
          - path: /
            pathType: Prefix

            backend:
              service:
                name: prometheus-grafana

                port:
                  number: 80

Apply:

kubectl apply -f grafana-ingress.yml
prometheus-ingress.yml

Create:

monitoring/prometheus-ingress.yml
apiVersion: networking.k8s.io/v1
kind: Ingress

metadata:
  name: prometheus-ingress
  namespace: monitoring

  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod

spec:
  ingressClassName: nginx

  tls:
    - hosts:
        - prometheus.metatechz.store
      secretName: prometheus-tls

  rules:
    - host: prometheus.metatechz.store

      http:
        paths:
          - path: /
            pathType: Prefix

            backend:
              service:
                name: prometheus-kube-prometheus-prometheus

                port:
                  number: 9090

Apply:

kubectl apply -f prometheus-ingress.yml
